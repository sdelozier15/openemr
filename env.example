# OpenEMR FHIR R4 base URL
OPENEMR_FHIR_BASE=https://localhost:9300/apis/default/fhir

# OpenEMR native REST base URL
OPENEMR_NATIVE_BASE=https://localhost:9300/apis/default/api

# CORS — comma-separated allowed origins for your SMART app
ALLOWED_ORIGINS=http://localhost:3000

# OpenEMR database credentials (required for AMC checkbox — Option 1)
# These are the default Docker dev credentials
OPENEMR_DB_HOST=localhost
OPENEMR_DB_PORT=3306
OPENEMR_DB_NAME=openemr
OPENEMR_DB_USER=openemr
OPENEMR_DB_PASS=openemr
